{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["cypress", "node"],
    "noEmit": true,
    "strict": true,
    "sourceMap": false,
    "skipLibCheck": true,
    "paths": {
      "support/*": ["./support/*"]
    }
  },
  "include": ["**/*.ts"]
}
